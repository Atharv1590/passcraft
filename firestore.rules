rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Accounts collection and nested collections
    match /accounts/{accountId} {
      allow read, write: if true;
      
      match /{subcollection}/{document=**} {
        allow read, write: if true;
      }
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
